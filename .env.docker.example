# Copy to .env.docker (never commit it). Generate each secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENVIRONMENT=production
POSTGRES_PASSWORD=change-me
OWNER_DB_PASSWORD=change-me
APP_DB_PASSWORD=change-me
PLATFORM_DB_PASSWORD=change-me
JWT_SECRET=change-me-at-least-32-characters-long
# 32 random bytes, base64url:  python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
DATA_ENCRYPTION_KEY=change-me
CHECKPOINT_SIGNING_KEY=change-me
# Set to true only when TLS terminates in front of the API (it must, in production).
COOKIE_SECURE=true
CORS_ORIGINS=[]
