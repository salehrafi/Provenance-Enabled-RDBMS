# Copy to .env, or let `python -m app.cli init` generate one with fresh secrets.
# Full reference: docs/DEPLOYMENT.md
ENVIRONMENT=development
DATABASE_URL=postgresql://prov_app:change-me@127.0.0.1:5432/provenance
DATABASE_OWNER_URL=postgresql://prov_owner:change-me@127.0.0.1:5432/provenance
DATABASE_ADMIN_URL=postgresql://postgres@127.0.0.1:5432/postgres
DATABASE_PLATFORM_URL=postgresql://prov_platform:change-me@127.0.0.1:5432/provenance
JWT_SECRET=change-me-at-least-32-characters-long
DATA_ENCRYPTION_KEY=change-me
CHECKPOINT_SIGNING_KEY=change-me
WORKERS_ENABLED=true
COOKIE_SECURE=false
WEBHOOK_ALLOW_PRIVATE_URLS=true
WEBHOOK_ALLOW_HTTP=true
DEMO_PASSWORD=change-me
