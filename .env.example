# Copy to .env (scripts/setup_db.py does this for you and fills in generated secrets).
ENVIRONMENT=development

# Oracle connection (host:port/service). ORCLPDB is the pluggable database.
DB_DSN=localhost:1521/orclpdb
DB_OWNER_USER=PROV_OWNER
DB_OWNER_PASSWORD=change-me
DB_APP_USER=PROV_APP
DB_APP_PASSWORD=change-me
DB_SCHEMA=PROV_OWNER

# Used only by scripts/setup_db.py (SYSDBA via OS authentication)
ORACLE_SID=ORCL
ORACLE_PDB=ORCLPDB
SQLPLUS_PATH=C:\oracle_db\bin\sqlplus.exe

# Auth
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Workers
WORKERS_ENABLED=true
WEBHOOK_ALLOW_PRIVATE_URLS=true

# Password for the seeded demo users (scripts/seed.py)
DEMO_PASSWORD=change-me
